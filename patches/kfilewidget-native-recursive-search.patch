+    searchEdit->setClearButtonEnabled(true);
+    searchEdit->setMinimumWidth(180);
+    searchEdit->setMaximumWidth(320);
+    searchEdit->setSizePolicy(
+        QSizePolicy::Preferred,
+        QSizePolicy::Fixed);
+
+    searchEdit->addAction(
+        QIcon::fromTheme(QStringLiteral("edit-find")),
+        QLineEdit::LeadingPosition);
+
+    searchEdit->setProperty("_kfileSearchBaseUrl", QVariant());
+    searchEdit->setProperty("_kfileSearchActive", false);
