+            }
+
+            const auto description = [](QWidget *w) -> QString {
+                if (!w) {
+                    return QStringLiteral("<null>");
+                }
+
+                return QStringLiteral("%1 object=%2 parent=%3")
+                    .arg(
+                        QString::fromLatin1(w->metaObject()->className()),
+                        w->objectName(),
+                        w->parentWidget()
+                            ? QString::fromLatin1(
+                                  w->parentWidget()
+                                      ->metaObject()
+                                      ->className())
+                            : QStringLiteral("<none>"));
+            };
+
+            QFile traceFile(
+                QStandardPaths::writableLocation(QStandardPaths::HomeLocation)
+                + QStringLiteral("/kfile-focus.log"));
+            if (traceFile.open(QIODevice::WriteOnly
+                               | QIODevice::Append
+                               | QIODevice::Text)) {
+
+                const QString url =
+                    searchEdit->window()
+                        ->findChild<KDirOperator *>()
+                        ? searchEdit->window()
+                              ->findChild<KDirOperator *>()
+                              ->url()
+                              .toString()
+                        : QStringLiteral("<no KDirOperator>");
+
+                const QString line =
+                    QStringLiteral(
+                        "KFILE-FOCUS: %1 --> %2 | searchHasFocus=%3 | url=%4\\n")
