+
+    q->connect(
+        searchEdit,
+        &QLineEdit::textChanged,
+        q,
+        [searchEdit,
+         searchDelay,
+         restoreBase](const QString &text) {
+
+            const QString term = text.trimmed();
+
+            /*
+             * This is the important part:
+             *
+             * typing/backspacing ONLY restarts the timer.
+             * It does not touch KDirOperator at all.
+             */
+            searchDelay->stop();
+
+            if (term.isEmpty()) {
+                restoreBase();
+                return;
+            }
+
+            searchDelay->start();
+        });
+
+    // Enter = apply whatever is CURRENTLY in the box immediately.
+    q->connect(
+        searchEdit,
+        &QLineEdit::returnPressed,
+        q,
+        [searchDelay, applySearch]() {
+
+            searchDelay->stop();
+            applySearch();
+        });
+
+    // Search hidden/non-hidden again using exactly the same text.
+    q->connect(
+        m_ops->action(KDirOperator::ShowHiddenFiles),
+        &QAction::toggled,
+        q,
+        [searchEdit,
+         searchDelay,
+         applySearch](bool) {
+
+            if (searchEdit->text().trimmed().isEmpty()) {
+                return;
+            }
+
+            searchDelay->stop();
+
+            // Force reapplication even though the text didn't change.
+            searchEdit->setProperty(
+                "_kfileSearchAppliedText",
+                QString());
+
+            applySearch();
+        });
+
+    // Escape clears search and returns to its real directory.
+    auto *cancelSearchAction = new QAction(q);
+    cancelSearchAction->setShortcut(
+        QKeySequence(Qt::Key_Escape));
+    cancelSearchAction->setShortcutContext(
+        Qt::WidgetWithChildrenShortcut);
+    q->addAction(cancelSearchAction);
+
+    q->connect(
+        cancelSearchAction,
+        &QAction::triggered,
+        q,
+        [searchEdit, restoreBase]() {
+
+            if (searchEdit->text().isEmpty()) {
+                return;
+            }
+
+            const QSignalBlocker blocker(searchEdit);
