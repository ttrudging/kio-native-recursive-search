+                            description(oldWidget),
+                            description(newWidget),
+                            searchEdit->hasFocus()
+                                ? QStringLiteral("yes")
+                                : QStringLiteral("no"),
+                            url);
+
+                traceFile.write(line.toUtf8());
+                traceFile.flush();
+            }
+        });
+
