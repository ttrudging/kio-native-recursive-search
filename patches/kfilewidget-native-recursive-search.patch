+                    QStringLiteral("yes"));
+            }
+
+            searchUrl.setQuery(query);
+
+            // Mark THIS exact text as what the view represents.
+            searchEdit->setProperty(
+                "_kfileSearchAppliedText",
+                term);
+
+            searchEdit->setProperty(
+                "_kfileSearchActive",
+                true);
+
+            /*
+             * Do NOT call m_ops->close() here.
+             *
+             * setUrl() replaces the current KDirLister URL itself.
