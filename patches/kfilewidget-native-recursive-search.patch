+    // Native recursive search for KFileWidget / KDE file dialogs.
+    //
+    // Interaction model:
+    //   - typing NEVER clears/reloads the view immediately
+    //   - search runs only after the user has stopped typing
+    //   - Enter searches immediately
+    //   - deleting characters searches the SHORTER current text
+    //   - empty text restores the original directory
+    //   - synthetic filenamesearch: URLs never enter navigation history
+
+    auto *searchEdit = new QLineEdit(m_toolbar);
