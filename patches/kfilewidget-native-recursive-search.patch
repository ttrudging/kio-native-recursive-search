+
+        if (traceFile.open(QIODevice::WriteOnly
+                           | QIODevice::Append
+                           | QIODevice::Text)) {
+            traceFile.write("KFILE-TRACE-INIT\\n");
+            traceFile.flush();
+        }
+    }
+
+    // TEMPORARY diagnostic: tell us exactly who steals focus while
